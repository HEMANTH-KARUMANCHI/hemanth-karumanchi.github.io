---
import { personalDetails } from '../data/portfolioData';
---

<footer class="border-t border-slate-200/80 dark:border-slate-800/80 bg-white/50 dark:bg-slate-950/50 py-10 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 text-xs sm:text-sm text-slate-500 dark:text-slate-400">
    
    <!-- Left Copy -->
    <div class="flex items-center gap-2">
      <div class="w-6 h-6 rounded-md bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 font-bold flex items-center justify-center text-[10px]">
        KH
      </div>
      <span>© {new Date().getFullYear()} {personalDetails.name}. All rights reserved.</span>
    </div>

    <!-- Right Back to Top Button -->
    <a 
      href="#hero" 
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 transition-colors font-medium text-xs"
    >
      <span>Back to top</span>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </a>

  </div>
</footer>
