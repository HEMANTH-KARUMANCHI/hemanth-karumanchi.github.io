---
import { experiences } from '../data/portfolioData';
---

<section id="experience" class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-slate-200/80 dark:border-slate-800/80">
  <div class="space-y-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h2 class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">
        Career Journey
      </h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Work Experience
      </p>
      <div class="w-12 h-1 bg-blue-600 dark:bg-blue-500 mx-auto rounded-full"></div>
    </div>

    <!-- Timeline Container -->
    <div class="max-w-4xl mx-auto relative border-l-2 border-slate-200 dark:border-slate-800 ml-4 sm:ml-8 pl-6 sm:pl-10 space-y-12">
      {experiences.map((exp, index) => (
        <div class="relative group">
          
          <!-- Timeline Node Dot -->
          <div class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-blue-600 dark:bg-blue-500 border-4 border-slate-50 dark:border-slate-950 group-hover:scale-125 transition-transform duration-200"></div>

          <!-- Experience Card -->
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:shadow-md transition-all duration-200 space-y-4">
            
            <!-- Role Header & Company -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 dark:border-slate-800/80 pb-4">
              <div>
                <h3 class="text-xl font-extrabold text-slate-900 dark:text-white">
                  {exp.role}
                </h3>
                <div class="flex items-center gap-2 text-sm font-semibold text-blue-600 dark:text-blue-400 mt-1">
                  <span>{exp.company}</span>
                  {exp.location && (
                    <span class="text-slate-400 dark:text-slate-500 font-normal">· {exp.location}</span>
                  )}
                </div>
              </div>

              <span class="inline-flex items-center self-start sm:self-center px-3 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
                <svg class="w-3.5 h-3.5 mr-1.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                {exp.period}
              </span>
            </div>

            <!-- Description Bullet Points -->
            <ul class="space-y-2 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
              {exp.description.map(item => (
                <li class="flex items-start gap-2.5">
                  <span class="text-blue-500 mt-1 text-xs">◆</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <!-- Tech Badges -->
            <div class="pt-2 flex flex-wrap gap-2">
              {exp.technologies.map(tech => (
                <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 border border-slate-200/60 dark:border-slate-700/60">
                  #{tech}
                </span>
              ))}
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>
